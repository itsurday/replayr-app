<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description>Dev and test only, not packaged. Bearer token in the Authorization header; the token is entered in Setup as the Token parameter of the Bearer_User principal.</description>
    <externalCredentialParameters>
        <parameterName>Bearer_User</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterName>Authorization</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>{!&apos;Bearer &apos; &amp; $Credential.Httpbin_Bearer_Auth.Token}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>Httpbin Bearer Auth</label>
</ExternalCredential>
