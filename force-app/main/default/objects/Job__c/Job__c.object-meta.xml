<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Job</label>
    <pluralLabel>Jobs</pluralLabel>
    <description>One call to an endpoint, queued and processed by a worker. Holds what was sent and what happened, never a secret or a full response body.</description>
    <nameField>
        <label>Job Number</label>
        <type>AutoNumber</type>
        <displayFormat>JOB-{000000}</displayFormat>
        <startingNumber>1</startingNumber>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>Private</sharingModel>
    <externalSharingModel>Private</externalSharingModel>
    <enableReports>true</enableReports>
</CustomObject>
