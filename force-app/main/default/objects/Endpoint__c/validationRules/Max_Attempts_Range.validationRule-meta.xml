<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Max_Attempts_Range</fullName>
    <active>true</active>
    <description>Max attempts must be between 1 and 10.</description>
    <errorConditionFormula>OR(Max_Attempts__c &lt; 1, Max_Attempts__c &gt; 10)</errorConditionFormula>
    <errorDisplayField>Max_Attempts__c</errorDisplayField>
    <errorMessage>Enter a number from 1 (never retry) to 10.</errorMessage>
</ValidationRule>
